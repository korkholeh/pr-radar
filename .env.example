# Copy to .env and adjust. See docs/CONFIGURATION.md for the full reference.

SECRET_KEY=change-me-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL=sqlite:///data/db.sqlite3
DATA_DIR=data
REPORT_TIMEZONE=Europe/Kyiv

# Comma-separated list; first key encrypts, all keys can decrypt (key rotation).
FIELD_ENCRYPTION_KEYS=

# Store raw GitHub payloads alongside derived fields (increases disk use).
STORE_RAW_PAYLOADS=False

# Personas seeded by `manage.py seed_e2e`.
E2E_ADMIN_PASSWORD=admin-password-change-me
E2E_LEAD_PASSWORD=lead-password-change-me
