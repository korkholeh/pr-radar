#: apps/connections/templates/connections/partials/list_content.html:28
msgid "Token"
msgstr "Токен"

#: apps/connections/forms.py:23
msgid "Leave blank to keep the current token."
msgstr "Залиште порожнім, щоб зберегти поточний токен."

#: apps/connections/forms.py:26
msgid "Save without verifying"
msgstr "Зберегти без перевірки"

#: apps/connections/forms.py:28
msgid "Skip the GitHub check and store this token as unverified."
msgstr "Пропустити перевірку GitHub і зберегти цей токен як неперевірений."

#: apps/connections/forms.py:38
msgid "A token is required."
msgstr "Токен обов'язковий."

