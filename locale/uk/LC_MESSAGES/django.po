#: apps/connections/check_codes.py:19
#, python-format
msgid "The token authenticates as %(login)s."
msgstr "Токен автентифікується як %(login)s."

#: apps/connections/check_codes.py:20 apps/connections/check_codes.py:28
#: apps/connections/check_codes.py:39 apps/connections/check_codes.py:54
#: apps/connections/check_codes.py:85
msgid "No action needed."
msgstr "Дія не потрібна."

#: apps/connections/check_codes.py:23
msgid "GitHub rejected this token."
msgstr "GitHub відхилив цей токен."

#: apps/connections/check_codes.py:24
msgid "Generate a new token and replace it on this connection."
msgstr "Створіть новий токен і замініть його в цьому підключенні."

#: apps/connections/check_codes.py:27
#, python-format
msgid "The token can see %(count)s repositories."
msgstr "Токен бачить %(count)s репозиторіїв."

#: apps/connections/check_codes.py:31
msgid "The token cannot see any repository."
msgstr "Токен не бачить жодного репозиторію."

#: apps/connections/check_codes.py:33
msgid ""
"Grant the token read access to the repositories you track. A fine-grained "
"token lists them explicitly, and an organization may also require single "
"sign-on authorization."
msgstr ""
"Надайте токену доступ на читання до репозиторіїв, які ви відстежуєте. У "
"fine-grained токені їх треба вибрати явно, а організація може додатково "
"вимагати авторизації єдиного входу (SSO)."

#: apps/connections/check_codes.py:38
#, python-format
msgid "The token can read pull requests on %(repository)s."
msgstr "Токен може читати pull request-и в %(repository)s."

#: apps/connections/check_codes.py:42
#, python-format
msgid "The token cannot read pull requests on %(repository)s."
msgstr "Токен не може читати pull request-и в %(repository)s."

#: apps/connections/check_codes.py:44
msgid ""
"Grant the token read access to pull requests on that repository and re-"
"check. A private repository needs more than a classic token's 'public_repo' "
"scope."
msgstr ""
"Надайте токену доступ на читання pull request-ів у цьому репозиторії та "
"перевірте ще раз. Для приватного репозиторію скоупа 'public_repo' класичного"
" токена недостатньо."

#: apps/connections/check_codes.py:49
msgid "Pull request access was not checked."
msgstr "Доступ до pull request-ів не перевірявся."

#: apps/connections/check_codes.py:50 apps/connections/check_codes.py:62
msgid "Add a repository to this connection, then re-check."
msgstr "Додайте репозиторій до цього підключення, потім перевірте ще раз."

#: apps/connections/check_codes.py:53
msgid "The token can read repository contents."
msgstr "Токен може читати вміст репозиторію."

#: apps/connections/check_codes.py:57
msgid "The token cannot read repository contents."
msgstr "Токен не може читати вміст репозиторію."

#: apps/connections/check_codes.py:58
msgid "Grant the token read access to repository contents and re-check."
msgstr ""
"Надайте токену доступ на читання вмісту репозиторію і перевірте ще раз."

#: apps/connections/check_codes.py:61
msgid "Repository contents access was not checked."
msgstr "Доступ до вмісту репозиторію не перевірявся."

#: apps/connections/check_codes.py:65
#, python-format
msgid "Organization %(org)s requires SSO authorization for this token."
msgstr "Організація %(org)s вимагає авторизації SSO для цього токена."

#: apps/connections/check_codes.py:66
#, python-format
msgid "Authorize the token for single sign-on at %(url)s."
msgstr "Авторизуйте токен для єдиного входу (SSO) за адресою %(url)s."

#: apps/connections/check_codes.py:70
msgid ""
"The classic token carries only 'public_repo', so it cannot read the private "
"repositories on this connection."
msgstr ""
"Класичний токен має лише 'public_repo', тому не може читати приватні "
"репозиторії цього підключення."

#: apps/connections/check_codes.py:74
msgid ""
"Replace it with a fine-grained token that has read access to those "
"repositories, or add the 'repo' scope to this one. GitHub reports no error "
"for this: a private repository simply syncs zero pull requests."
msgstr ""
"Замініть його на fine-grained токен із доступом на читання цих репозиторіїв "
"або додайте скоуп 'repo' до цього. GitHub не повідомляє про цю помилку: "
"приватний репозиторій просто синхронізує нуль pull request-ів."

#: apps/connections/check_codes.py:80
msgid ""
"The classic token carries the full 'repo' scope, which grants write access."
msgstr "Класичний токен має повний скоуп 'repo', що надає доступ на запис."

#: apps/connections/check_codes.py:81
msgid ""
"Replace it with a fine-grained token limited to the repositories PR Radar "
"reads."
msgstr ""
"Замініть його дрібнозернистим токеном, обмеженим репозиторіями, які читає PR"
" Radar."

#: apps/connections/check_codes.py:84
#, python-format
msgid "%(remaining)s API requests remain until %(reset_at)s."
msgstr "Залишилося %(remaining)s запитів API до %(reset_at)s."

