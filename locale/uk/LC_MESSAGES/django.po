#: apps/ai_detection/evidence.py:55
#, python-format
msgid ""
"%(lines)s lines across %(files)s files arrived %(hours)s hours after the "
"first commit (the rule flags %(min_lines)s lines and %(min_files)s files "
"within %(max_hours)s hours)."
msgstr ""
"%(lines)s рядків у %(files)s файлах надійшли через %(hours)s год після "
"першого коміту (правило спрацьовує на %(min_lines)s рядках і %(min_files)s "
"файлах протягом %(max_hours)s год)."

#: apps/ai_detection/evidence.py:72
#, python-format
msgid ""
"The whole change — %(lines)s lines across %(files)s files — arrived in a "
"single commit (the rule flags %(min_lines)s lines and %(min_files)s files)."
msgstr ""
"Уся зміна — %(lines)s рядків у %(files)s файлах — надійшла одним комітом "
"(правило спрацьовує на %(min_lines)s рядках і %(min_files)s файлах)."

#: apps/ai_detection/evidence.py:78
#, python-format
msgid ""
"%(added_files)s new files were added across %(directories)s directories (the"
" rule flags %(min_added_files)s files across %(min_directories)s "
"directories)."
msgstr ""
"Додано %(added_files)s нових файлів у %(directories)s каталогах (правило "
"спрацьовує на %(min_added_files)s файлах у %(min_directories)s каталогах)."

#: apps/ai_detection/evidence.py:84
#, python-format
msgid ""
"%(manifest)s adds the dependency %(package)s, and nothing else in this "
"change imports it."
msgstr ""
"%(manifest)s додає залежність %(package)s, і ніщо інше в цій зміні її не "
"імпортує."

#: apps/ai_detection/evidence.py:100
#, python-format
msgid ""
"This author opened %(recent_per_week)s pull requests a week recently, "
"against %(earlier_per_week)s a week before that — %(ratio)s times their own "
"rate once the team's own change of %(team_ratio)s is divided out (the rule "
"flags %(min_ratio)s)."
msgstr ""
"Останнім часом цей автор відкривав %(recent_per_week)s PR на тиждень проти "
"%(earlier_per_week)s на тиждень до того — у %(ratio)s разів більше за "
"власний темп після врахування зміни самої команди у %(team_ratio)s (правило "
"спрацьовує на %(min_ratio)s)."

#: apps/ai_detection/evidence.py:107
#, python-format
msgid ""
"%(share)s%% of this author's recent volume landed outside the hours they "
"usually commit in (%(usual_hours)s); the rule flags %(min_share)s%%."
msgstr ""
"%(share)s%% нещодавнього обсягу цього автора припали на години поза тими, у "
"які він зазвичай комітить (%(usual_hours)s); правило спрацьовує на "
"%(min_share)s%%."

#: apps/ai_detection/evidence.py:113
#, python-format
msgid ""
"Across %(pr_count)s pull requests the test-to-code ratio stayed at about "
"%(mean_ratio)s, varying by only %(spread)s (the rule flags a variation under"
" %(max_variance)s)."
msgstr ""
"У %(pr_count)s PR співвідношення тестів до коду трималося близько "
"%(mean_ratio)s і змінювалося лише на %(spread)s (правило спрацьовує на "
"відхиленні менше ніж %(max_variance)s)."

#: apps/ai_detection/evidence.py:120
#, python-format
msgid ""
"This author's pull-request descriptions run about %(recent_length)s "
"characters recently, against %(earlier_length)s before — %(ratio)s times the"
" difference the rule flags at %(min_ratio)s."
msgstr ""
"Описи PR цього автора останнім часом мають близько %(recent_length)s "
"символів проти %(earlier_length)s раніше — різниця у %(ratio)s разів, тоді "
"як правило спрацьовує на %(min_ratio)s."

#: apps/ai_detection/evidence.py:127
#, python-format
msgid ""
"Of %(lines)s changed lines only %(semantic_lines)s change anything but "
"whitespace — %(share)s%% of the diff (the rule flags %(min_lines)s lines at "
"or below %(max_share)s%%)."
msgstr ""
"Зі %(lines)s змінених рядків лише %(semantic_lines)s змінюють щось, окрім "
"пробілів, — %(share)s%% дифу (правило спрацьовує на %(min_lines)s рядках за "
"умови %(max_share)s%% або менше)."

#: apps/ai_detection/evidence.py:133
#, python-format
msgid ""
"The added code is %(density)s%% comments and docstrings (%(comment_lines)s "
"comment lines to %(code_lines)s code lines), against %(baseline_density)s%% "
"in the same files before the change — the rule flags %(ratio)s times the "
"baseline, at %(min_density)s%% or more."
msgstr ""
"Доданий код на %(density)s%% складається з коментарів і докстрингів "
"(%(comment_lines)s рядків коментарів проти %(code_lines)s рядків коду), "
"тоді як у тих самих файлах до зміни було %(baseline_density)s%%. Правило "
"спрацьовує на перевищенні базового рівня в %(ratio)s разів за щільності "
"%(min_density)s%% або більше."

#: apps/ai_detection/evidence.py:161
#, python-format
msgid ""
"%(commits)s substantial commits landed less than %(gap_seconds)s seconds "
"apart (the rule flags %(min_commits)s such commits within "
"%(max_gap_seconds)s seconds)."
msgid_plural ""
"%(commits)s substantial commits landed less than %(gap_seconds)s seconds "
"apart (the rule flags %(min_commits)s such commits within "
"%(max_gap_seconds)s seconds)."
msgstr[0] ""
"%(commits)s великий коміт надійшов з інтервалом менше ніж %(gap_seconds)s с "
"(правило спрацьовує на %(min_commits)s таких комітах протягом "
"%(max_gap_seconds)s с)."
msgstr[1] ""
"%(commits)s великі коміти надійшли з інтервалом менше ніж %(gap_seconds)s с "
"(правило спрацьовує на %(min_commits)s таких комітах протягом "
"%(max_gap_seconds)s с)."
msgstr[2] ""
"%(commits)s великих комітів надійшли з інтервалом менше ніж %(gap_seconds)s "
"с (правило спрацьовує на %(min_commits)s таких комітах протягом "
"%(max_gap_seconds)s с)."
msgstr[3] ""
"%(commits)s великих комітів надійшли з інтервалом менше ніж %(gap_seconds)s "
"с (правило спрацьовує на %(min_commits)s таких комітах протягом "
"%(max_gap_seconds)s с)."

#: apps/ai_detection/evidence.py:168
#, python-format
msgid ""
"A new commit followed a review comment within %(max_minutes)s minutes, "
"%(occurrences)s time (the rule flags %(min_occurrences)s such times)."
msgid_plural ""
"A new commit followed a review comment within %(max_minutes)s minutes, "
"%(occurrences)s times (the rule flags %(min_occurrences)s such times)."
msgstr[0] ""
"Новий коміт надійшов протягом %(max_minutes)s хв після коментаря ревʼю "
"%(occurrences)s раз (правило спрацьовує на %(min_occurrences)s таких разах)."
msgstr[1] ""
"Новий коміт надходив протягом %(max_minutes)s хв після коментаря ревʼю "
"%(occurrences)s рази (правило спрацьовує на %(min_occurrences)s таких "
"разах)."
msgstr[2] ""
"Новий коміт надходив протягом %(max_minutes)s хв після коментаря ревʼю "
"%(occurrences)s разів (правило спрацьовує на %(min_occurrences)s таких "
"разах)."
msgstr[3] ""
